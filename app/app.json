{
  "expo": {
    "name": "Eclaircie",
    "slug": "eclaircie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.eclaircie",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Éclaircie"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEE1C0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a1f2e"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2B457"
        }
      ]
    ],
    "scheme": "eclaircie",
    "splash": {
      "backgroundColor": "#0a1f2e"
    },
    "newArchEnabled": true,
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2a57ba9a-3098-4435-9800-490a8e4141ee"
      }
    },
    "owner": "adriengrampone"
  }
}
