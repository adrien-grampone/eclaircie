{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@pipeline/*": [
        "./supabase/functions/_shared/pipeline/*"
      ],
      "@/*": [
        "./app/src/*"
      ]
    }
  },
  "include": [
    "supabase/functions/_shared/pipeline/**/*.ts",
    "app/src/lib/color.ts",
    "app/src/lib/daily.ts",
    "app/src/lib/illustration.ts",
    "app/src/lib/__tests__/**/*.ts",
    "app/src/types.ts",
    "app/src/theme/tokens.ts",
    "vitest.config.ts"
  ]
}
