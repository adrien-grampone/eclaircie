# Fichiers retirés de l'archive envoyée à EAS Build (racine du dépôt git). Seul app/ sert au build ;
# les variables d'environnement viennent de `eas env`, jamais d'un .env.

# Déjà ignorés par git (sécurité)
node_modules/
supabase/.temp/
supabase/.branches/
.env
.env.*
*.log
.DS_Store
app/.expo/
app/dist/
app/web-build/
app/ios/
app/android/
app/*.tsbuildinfo

# Hors app : pipeline, back-office, maquettes, captures, rapports, docs, outils racine.
# Les entrées de fichiers sont ancrées à la racine (/) : sans la barre, `package.json` effacerait aussi app/package.json.
# supabase/ sauf le module pur du pipeline, importé par l'app via @pipeline (metro.config.js) ; sans ses tests.
# Exceptions SANS barre finale : eas-cli copie l'arbre avec le paquet `ignore`, qui ne sait pas qu'un chemin est un dossier.
/supabase/*
!/supabase/functions
/supabase/functions/*
!/supabase/functions/_shared
/supabase/functions/_shared/*
!/supabase/functions/_shared/pipeline
/supabase/functions/_shared/pipeline/__tests__
/admin/
/design/
/docs/
/reports/
/*.md
/package.json
/package-lock.json
/tsconfig.json
/vitest.config.ts
app/src/**/*.test.ts
